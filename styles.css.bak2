/* ============================================================

   STACKLY — Shared Stylesheet

   ============================================================ */



/* ── Scroll Reveal Animations ──────────────────────────────── */

/* Base hidden state */
.reveal,
.reveal-left,
.reveal-right,
.reveal-bottom {
  opacity: 0;
  transition:
    opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

/* From bottom (default reveal) */
.reveal,
.reveal-bottom {
  transform: translateY(48px);
}

/* From left */
.reveal-left {
  transform: translateX(-64px);
}

/* From right */
.reveal-right {
  transform: translateX(64px);
}

/* Visible state — triggered by JS adding .in */
.reveal.in,
.reveal-left.in,
.reveal-right.in,
.reveal-bottom.in {
  opacity: 1;
  transform: translate(0, 0);
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .reveal, .reveal-left, .reveal-right, .reveal-bottom {
    transition: opacity 0.4s ease;
    transform: none;
  }
}



/* ── Custom Properties ─────────────────────────────────────── */

:root {

  --ink:        #15130f;

  --ink-2:      #1d1a15;

  --paper:      #f3ece0;

  --paper-dim:  #b7ab97;

  --paper-faint:#7e7565;

  --amber:      #e0a44a;

  --amber-deep: #c67f2b;

  --moss:       #59705e;

  --line:       rgba(243,236,224,0.14);

  --radius:     2px;

}



/* ── Reset ─────────────────────────────────────────────────── */

*, *::before, *::after {

  margin: 0;

  padding: 0;

  box-sizing: border-box;

}



html {

  scroll-behavior: smooth;

  overflow-x: hidden;

}



body {

  background: var(--ink);

  color: var(--paper);

  font-family: 'Inter', sans-serif;

  font-size: 16px;

  line-height: 1.5;

  overflow-x: hidden;

}



::selection {

  background: var(--amber);

  color: var(--ink);

}



a {

  color: inherit;

  text-decoration: none;

}





img {

  display: block;

  max-width: 100%;

}



.wrap {

  max-width: 1240px;

  margin: 0 auto;

  padding: 0 40px;

}



/* ── Stats Strip (below hero video) ────────────────────────── */

.stats-strip {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  background: var(--ink-2);

  border-bottom: 1px solid var(--line);

}

.stats-strip__item {

  padding: 32px 24px;

  text-align: center;

  border-right: 1px solid var(--line);

}

.stats-strip__item:last-child {

  border-right: none;

}

.stats-strip__item strong {

  display: block;

  font-family: 'Fraunces', serif;

  font-size: 38px;

  font-weight: 500;

  color: var(--amber);

  line-height: 1;

  margin-bottom: 7px;

}

.stats-strip__item span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  letter-spacing: 0.10em;

  text-transform: uppercase;

}

@media (max-width: 768px) {

  .stats-strip { grid-template-columns: repeat(2, 1fr); }

  .stats-strip__item:nth-child(2) { border-right: none; }

  .stats-strip__item:nth-child(1),

  .stats-strip__item:nth-child(2) { border-bottom: 1px solid var(--line); }

}





/* ── Typography ────────────────────────────────────────────── */

.eyebrow {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  letter-spacing: 0.18em;

  text-transform: uppercase;

  color: var(--amber);

  display: flex;

  align-items: center;

  gap: 14px;

}



.eyebrow::before {

  content: '';

  display: inline-block;

  width: 22px;

  height: 1px;

  background: var(--amber);

  flex-shrink: 0;

}



h1, h2, h3 {

  font-family: 'Fraunces', serif;

  font-weight: 500;

}



/* ── Buttons ───────────────────────────────────────────────── */

.btn {

  font-family: 'Inter', sans-serif;

  font-size: 14px;

  font-weight: 600;

  padding: 13px 26px;

  border-radius: var(--radius);

  display: inline-flex;

  align-items: center;

  gap: 8px;

  border: 1px solid transparent;

  cursor: pointer;

  transition: transform 0.25s, background 0.25s, color 0.25s, border-color 0.25s;

  text-decoration: none;

  line-height: 1;

}





.btn:hover {

  transform: translateY(-2px);

}



.btn-solid {

  background: var(--amber);

  color: var(--ink);

  border-color: var(--amber);

}



.btn-solid:hover {

  background: var(--paper);

  border-color: var(--paper);

  color: var(--ink);

}



.btn-ghost {

  background: transparent;

  color: var(--paper);

  border-color: var(--line);

}



.btn-ghost:hover {

  border-color: var(--amber);

  color: var(--amber);

}



/* ── Header / Nav ──────────────────────────────────────────── */

header {

  position: fixed;

  top: 0;

  left: 0;

  right: 0;

  z-index: 100;

  background: rgba(21,19,15,0.72);

  backdrop-filter: blur(14px);

  -webkit-backdrop-filter: blur(14px);

  border-bottom: 1px solid var(--line);

}



.nav {

  max-width: 1240px;

  margin: 0 auto;

  padding: 0 40px;

  height: 78px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  position: relative;

}



.logo {

  display: flex;

  align-items: center;

  flex-shrink: 0;

  text-decoration: none;

}



.logo img {

  height: 44px;

  width: auto;

  max-width: none;

}



.navlinks {

  display: flex;

  align-items: center;

  gap: 38px;

  font-family: 'Inter', sans-serif;

  font-size: 14px;

  font-weight: 500;

  color: var(--paper-dim);

  list-style: none;

}



.navlinks a {

  position: relative;

  color: var(--paper-dim);

  transition: color 0.25s;

  padding-bottom: 4px;

}



.navlinks a::after {

  content: '';

  position: absolute;

  bottom: -2px;

  left: 0;

  right: 0;

  height: 1px;

  background: var(--amber);

  transform: scaleX(0);

  transform-origin: left;

  transition: transform 0.3s;

}



.navlinks a:hover,

.navlinks a.active {

  color: var(--paper);

}



.navlinks a:hover::after,

.navlinks a.active::after {

  transform: scaleX(1);

}



.navright {

  display: flex;

  align-items: center;

  gap: 22px;

}



.login-link {

  font-size: 14px;

  font-weight: 500;

  color: var(--paper-dim);

  transition: color 0.25s;

}



.login-link:hover {

  color: var(--paper);

}



/* Burger (injected via JS) */

.burger {

  display: none;

  flex-direction: column;

  gap: 5px;

  background: none;

  border: none;

  cursor: pointer;

  padding: 6px;

}



.burger span {

  display: block;

  width: 22px;

  height: 1.5px;

  background: var(--paper);

  transition: 0.3s;

}



/* ── Page Banner (inner pages) ─────────────────────────────── */

.page-banner {

  padding: 160px 0 80px;

  border-bottom: 1px solid var(--line);

}



.page-banner h1 {

  font-family: 'Fraunces', serif;

  font-size: clamp(36px, 4vw, 60px);

  max-width: 640px;

  margin-top: 20px;

  line-height: 1.05;

}



.page-banner p {

  color: var(--paper-dim);

  font-size: 17px;

  max-width: 500px;

  margin-top: 16px;

  line-height: 1.65;

}



.crumb {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.08em;

  margin-bottom: 16px;

}



.crumb a:hover {

  color: var(--amber);

}



.page-hero {

  position: relative;

  overflow: hidden;

  min-height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 0;

  border-bottom: 1px solid var(--line);

}



.page-hero__bg {

  position: absolute;

  inset: 0;

  width: 100%;

  height: 100%;

  object-fit: cover;

  object-position: center;

  z-index: 0;

}



.page-hero__overlay {

  position: absolute;

  inset: 0;

  z-index: 1;

  background:

    linear-gradient(to bottom,

      rgba(21,19,15,0.62) 0%,

      rgba(21,19,15,0.38) 42%,

      rgba(21,19,15,0.78) 100%);

}



.page-hero .wrap {

  position: relative;

  z-index: 2;

  padding-top: 80px;

  padding-bottom: 80px;

  width: 100%;

  text-align: center;

}



.page-hero .eyebrow {

  justify-content: center;

}



.page-hero h1 {

  color: var(--paper);

  max-width: 780px;

  margin-left: auto;

  margin-right: auto;

}



.page-hero p {

  color: rgba(243, 236, 224, 0.82);

  max-width: 560px;

  margin-left: auto;

  margin-right: auto;

}



.page-hero .crumb,

.page-hero .breadcrumb {

  color: var(--paper-faint);

}



/* ── Hero (index only) ─────────────────────────────────────── */

.hero {

  padding: 190px 0 110px;

  display: grid;

  grid-template-columns: 1.05fr 0.95fr;

  gap: 40px;

  align-items: center;

}



.hero-copy h1 {

  font-family: 'Fraunces', serif;

  font-size: clamp(44px, 5.4vw, 76px);

  line-height: 0.98;

}



.hero-copy h1 em {

  font-style: italic;

  color: var(--amber);

  font-weight: 400;

}



.hero-copy p {

  margin-top: 26px;

  max-width: 430px;

  color: var(--paper-dim);

  font-size: 16.5px;

  line-height: 1.65;

}



.hero-cta {

  display: flex;

  align-items: center;

  gap: 16px;

  margin-top: 38px;

}



.hero-meta {

  display: flex;

  gap: 30px;

  margin-top: 56px;

  padding-top: 28px;

  border-top: 1px solid var(--line);

  max-width: 460px;

}



.hero-meta strong {

  font-family: 'Fraunces', serif;

  font-size: 22px;

  color: var(--paper);

  display: block;

}



.hero-meta span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.05em;

}



/* ── Photo Stack ───────────────────────────────────────────── */

.stack {

  position: relative;

  height: 520px;

}



.print {

  position: absolute;

  width: 280px;

  background: var(--ink-2);

  border: 1px solid var(--line);

  padding: 10px 10px 46px;

  border-radius: 1px;

  box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);

  transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);

}



.print img {

  width: 100%;

  height: 300px;

  object-fit: cover;

  filter: saturate(0.92) contrast(1.03);

}



.print .cap {

  font-family: 'JetBrains Mono', monospace;

  font-size: 10px;

  color: var(--paper-faint);

  display: flex;

  justify-content: space-between;

  margin-top: 12px;

}



.p1 {

  top: 0;

  left: 70px;

  transform: rotate(-7deg);

  z-index: 1;

}



.p2 {

  top: 40px;

  left: 230px;

  transform: rotate(4deg);

  z-index: 2;

}



.p3 {

  top: 110px;

  left: 10px;

  transform: rotate(3deg);

  z-index: 3;

}



.stack:hover .p1 {

  transform: rotate(-11deg) translate(-14px, -6px);

}



.stack:hover .p2 {

  transform: rotate(8deg) translate(14px, -10px);

}



.stack:hover .p3 {

  transform: rotate(-1deg) translate(0, 10px);

}



/* ── Marquee ───────────────────────────────────────────────── */

.marquee {

  border-top: 1px solid var(--line);

  border-bottom: 1px solid var(--line);

  padding: 16px 0;

  overflow: hidden;

  white-space: nowrap;

  background: var(--ink-2);

}



.marquee-track {

  display: inline-flex;

  animation: scroll 32s linear infinite;

}



.marquee span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 13px;

  letter-spacing: 0.06em;

  color: var(--paper-faint);

  text-transform: uppercase;

  padding: 0 26px;

  display: inline-flex;

  align-items: center;

  gap: 26px;

}



.marquee span::after {

  content: '—';

  color: var(--amber-deep);

}



@keyframes scroll {

  from { transform: translateX(0); }

  to   { transform: translateX(-50%); }

}



/* ── Section base ──────────────────────────────────────────── */

section {

  padding: 60px 0;

}



.section-head {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 40px;

  margin-bottom: 48px;

}



.section-head h2 {

  font-family: 'Fraunces', serif;

  font-size: clamp(32px, 4.5vw, 52px);

  line-height: 1.1;

  font-weight: 400;

  color: var(--paper);

  letter-spacing: -0.02em;

  margin-top: 0;

  margin-bottom: 0;

}



.section-head p {

  color: var(--paper-dim);

  max-width: 400px;

  font-size: 17px;

  line-height: 1.6;

  margin-bottom: 12px;

}



.section-head.is-center {

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  margin-left: auto;

  margin-right: auto;

  max-width: 800px;

  gap: 8px;

}



.section-head.is-center h2 {

  margin-top: 0;

}



.section-head.is-center p {

  max-width: 560px;

  margin: 4px auto 0;

}



.section-head.is-center .eyebrow {

  justify-content: center;

}



/* ── About ─────────────────────────────────────────────────── */

.about {

  border-top: 1px solid var(--line);

}



.about-grid {

  display: grid;

  grid-template-columns: 0.9fr 1.1fr;

  gap: 70px;

  align-items: center;

}



.about-frame {

  position: relative;

}



.about-frame img {

  width: 100%;

  height: 480px;

  object-fit: cover;

  filter: saturate(0.9);

}



.about-frame::before {

  content: '';

  position: absolute;

  top: 20px;

  left: -20px;

  right: 20px;

  bottom: -20px;

  border: 1px solid var(--amber-deep);

  z-index: -1;

}



.about-copy p {

  color: var(--paper-dim);

  margin-bottom: 20px;

  line-height: 1.75;

  font-size: 15.5px;

  max-width: 480px;

}



.about-copy p:first-of-type {

  color: var(--paper);

  font-size: 19px;

  font-family: 'Fraunces', serif;

  font-style: italic;

  line-height: 1.5;

}



.stat-row {

  display: flex;

  gap: 50px;

  margin-top: 40px;

}



.stat-row strong,

.stat-num {

  font-family: 'Fraunces', serif;

  font-size: 34px;

  color: var(--amber);

  font-weight: 500;

  display: block;

}



.stat-row span,

.stat-label {

  font-size: 12px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.05em;

}



/* ── Services ──────────────────────────────────────────────── */

.services {

  border-top: 1px solid var(--line);

}





.service-row {

  display: grid;

  grid-template-columns: 70px 1.2fr 1.8fr auto;

  gap: 30px;

  align-items: center;

  padding: 34px 0;

  border-bottom: 1px solid var(--line);

  transition: padding-left .35s cubic-bezier(.22,1,.36,1), background .35s;

  text-decoration: none;

}



.service-row:hover {

  padding-left: 14px;

  background: rgba(224, 164, 74, 0.04);

}



.service-row .num {

  font-family: 'JetBrains Mono', monospace;

  color: var(--paper-faint);

  font-size: 13px;

}



.service-row h3 {

  font-family: 'Fraunces', serif;

  font-size: 26px;

  font-weight: 400;

  color: var(--paper);

  margin: 0;

}



.service-row p {

  color: var(--paper-dim);

  font-size: 14.5px;

  line-height: 1.6;

  margin: 0;

  max-width: 480px;

}



.service-row .arrow {

  width: 38px;

  height: 38px;

  border: 1px solid var(--line);

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  color: var(--paper-dim);

  transition: border-color .3s, color .3s, transform .3s;

  font-size: 16px;

  background: transparent;

}



.service-row:hover .arrow {

  border-color: var(--amber);

  color: var(--amber);

  transform: rotate(45deg);

}



@media (max-width: 768px) {

  .service-row {

    grid-template-columns: 40px 1fr auto;

    gap: 16px;

    padding: 24px 0;

  }

  .service-row p {

    display: none;

  }

}



.service-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 28px;

}



.service-grid--4 {

  grid-template-columns: repeat(4, 1fr);

}



.service-card {

  border: 1px solid var(--line);

  padding: 32px 28px;

  background: var(--ink);

}

.inclusion-icon {
  width: 30px;
  height: 30px;
  display: block;
  margin-bottom: 18px;
  color: var(--amber);
}



.service-card .num {

  font-family: 'JetBrains Mono', monospace;

  font-size: 12px;

  color: var(--amber);

  display: block;

  margin-bottom: 18px;

  letter-spacing: 0.06em;

}



.service-card h3 {

  font-family: 'Fraunces', serif;

  font-size: 22px;

  font-weight: 400;

  margin: 0 0 10px;

  letter-spacing: -0.02em;

}



.service-card p {

  font-size: 14px;

  color: var(--paper-dim);

  line-height: 1.65;

  margin: 0;

}



/* ── Gallery ───────────────────────────────────────────────── */

.gallery {

  border-top: 1px solid var(--line);

}



.gallery-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 24px;

}



.g-item {

  display: flex;

  flex-direction: column;

}



.g-img-wrap {

  width: 100%;

  aspect-ratio: 3 / 2; /* True 35mm film aspect ratio */

  overflow: hidden;

  position: relative;

  margin-bottom: 16px;

  background: var(--ink-2);

}



.g-img-wrap img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition: transform 0.8s ease;

}



.g-item:hover .g-img-wrap img {

  transform: scale(1.05);

}



.g-item .caption {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.1em;

  text-align: center;

}



.gallery-grid .g-item > img {

  width: 100%;

  aspect-ratio: 3 / 2;

  height: auto;

  object-fit: cover;

  display: block;

}



.g-stat {

  text-align: center;

}



.timeline {

  margin: 0 auto;

}





.gallery-more {

  display: flex;

  justify-content: center;

  margin-top: 48px;

}



/* ── Filters ───────────────────────────────────────────────── */

.filters {

  display: flex;

  gap: 10px;

  margin-bottom: 40px;

  flex-wrap: wrap;

}



.filters.is-center {

  justify-content: center;

}



.filter-btn {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.08em;

  border: 1px solid var(--line);

  padding: 8px 18px;

  background: transparent;

  color: var(--paper-dim);

  cursor: pointer;

  transition: border-color 0.25s, color 0.25s;

}



.filter-btn:hover,

.filter-btn.active {

  border-color: var(--amber);

  color: var(--amber);

}



/* ── Packages ──────────────────────────────────────────────── */

.packages {

  border-top: 1px solid var(--line);

}



.pkg-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 1px;

  background: var(--line);

  border: 1px solid var(--line);

}



.pkg-card {

  background: var(--ink);

  display: flex;

  flex-direction: column;

}



.pkg-card.featured {

  background: var(--ink-2);

}



.pkg-img {

  height: 200px;

  overflow: hidden;

}



.pkg-img img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  filter: saturate(0.85) brightness(0.9);

}



.pkg-body {

  padding: 34px 30px 38px;

  display: flex;

  flex-direction: column;

  flex: 1;

}



.pkg-badge {

  font-family: 'JetBrains Mono', monospace;

  font-size: 10px;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  color: var(--amber);

  margin-bottom: 10px;

}



.pkg-card h3 {

  font-family: 'Fraunces', serif;

  font-size: 24px;

}



.pkg-price {

  font-family: 'Fraunces', serif;

  font-size: 38px;

  color: var(--paper);

  margin: 10px 0 20px;

}



.pkg-price span {

  font-family: 'Inter', sans-serif;

  font-size: 13px;

  color: var(--paper-faint);

  font-weight: 500;

}



.pkg-list {

  list-style: none;

  margin-bottom: 28px;

  flex: 1;

}



.pkg-list li {

  font-size: 14px;

  color: var(--paper-dim);

  padding: 10px 0;

  border-top: 1px solid var(--line);

  display: flex;

  align-items: flex-start;

  gap: 10px;

}



.pkg-list li::before {

  content: '—';

  color: var(--amber-deep);

  flex-shrink: 0;

}



/* ── Process ───────────────────────────────────────────────── */

.process {

  border-top: 1px solid var(--line);

}



.process-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 30px;

}



.process-step {

  position: relative;

  text-align: center;

}



.process-img {

  height: 220px;

  overflow: hidden;

  margin-bottom: 22px;

  position: relative;

}



.process-img img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  filter: saturate(0.9);

}



.process-img .step-num {

  position: absolute;

  top: 12px;

  left: 12px;

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--ink);

  background: var(--amber);

  padding: 4px 10px;

}



.process-step > img {

  width: 100%;

  height: 220px;

  object-fit: cover;

  display: block;

  margin-bottom: 22px;

  filter: saturate(0.9);

}



.process-step > .step-num {

  display: inline-block;

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--amber);

  margin-bottom: 12px;

  letter-spacing: 0.06em;

}



.process-step p {

  font-size: 13.5px;

  color: var(--paper-dim);

  line-height: 1.6;

}



/* ── Team ──────────────────────────────────────────────────── */

.team {

  border-top: 1px solid var(--line);

}



.team-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 26px;

}



.team-card {

  position: relative;

}



.team-photo {

  height: 320px;

  overflow: hidden;

  position: relative;

}



.team-photo::after {

  content: '';

  position: absolute;

  inset: 0;

  background: linear-gradient(to bottom, transparent 55%, rgba(21,19,15,0.85));

}



.team-photo img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  filter: saturate(0.85);

  transition: transform 0.6s;

}



.team-card:hover .team-photo img {

  transform: scale(1.05);

}



.team-info {

  margin-top: 16px;

  display: flex;

  justify-content: space-between;

  align-items: flex-start;

}



.team-info h4 {

  font-family: 'Fraunces', serif;

  font-size: 19px;

  font-weight: 500;

}



.team-info span {

  font-size: 12px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.04em;

}



.team-info .soc {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--amber);

}



/* ── Journal ───────────────────────────────────────────────── */

.journal {

  border-top: 1px solid var(--line);

}



.journal-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 40px 28px;

}



.journal-card {

  display: flex;

  flex-direction: column;

}



.journal-thumb {

  overflow: hidden;

  aspect-ratio: 4 / 3;

  margin-bottom: 18px;

  background: var(--ink-2);

}



.journal-card img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

  filter: saturate(0.92);

  transition: transform 0.6s ease;

}



.journal-card:hover img {

  transform: scale(1.04);

}



.journal-meta {

  display: flex;

  gap: 14px;

  padding: 0 0 8px;

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.04em;

}



.journal-meta .cat {

  color: var(--amber);

}



.journal-card h3 {

  font-family: 'Fraunces', serif;

  font-size: 22px;

  font-weight: 400;

  margin: 0 0 8px;

  line-height: 1.25;

  letter-spacing: -0.02em;

}



.journal-card p {

  font-size: 14px;

  color: var(--paper-dim);

  line-height: 1.6;

  margin: 0 0 14px;

}



.journal-card .read-link {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--amber);

  text-transform: uppercase;

  letter-spacing: 0.06em;

  margin-top: auto;

}



.featured-post {

  display: grid;

  grid-template-columns: 1.15fr 0.85fr;

  gap: 56px;

  align-items: center;

}



.featured-post img {

  width: 100%;

  height: 440px;

  object-fit: cover;

  display: block;

  filter: saturate(0.92);

}



.featured-post h2 {

  font-family: 'Fraunces', serif;

  font-size: clamp(28px, 3vw, 38px);

  font-weight: 400;

  line-height: 1.15;

  margin: 10px 0 16px;

  letter-spacing: -0.02em;

}



.featured-post p {

  color: var(--paper-dim);

  font-size: 16px;

  line-height: 1.7;

  margin-bottom: 28px;

}



.journal-stats {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 1px;

  background: var(--line);

  border: 1px solid var(--line);

  margin-bottom: 80px;

}



.journal-stats .g-stat {

  background: var(--ink-2);

  padding: 28px 24px;

}



.journal-stats .g-stat strong {

  display: block;

  font-family: 'Fraunces', serif;

  font-size: 30px;

  color: var(--amber);

  font-weight: 500;

  margin-bottom: 4px;

}



.journal-stats .g-stat span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.05em;

}



/* ── FAQ ───────────────────────────────────────────────────── */

.faq {

  border-top: 1px solid var(--line);

}



.faq-list {

  max-width: 760px;

  margin: 0 auto;

}



.faq-item {

  border-bottom: 1px solid var(--line);

}



.faq-q {

  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 26px 0;

  cursor: pointer;

  gap: 20px;

}



.faq-q h4 {

  transition: all 0.3s ease;

  font-family: 'Fraunces', serif;

  font-size: 18px;

  font-weight: 400;

}



.faq-q:hover h4 { color: var(--amber); transform: translateX(8px); }

.faq-q .plus {

  font-size: 20px;

  color: var(--amber);

  transition: transform 0.3s;

  flex-shrink: 0;

  line-height: 1;

}



.faq-item.open .faq-q:hover h4 { color: var(--amber); transform: translateX(8px); }

.faq-q .plus {

  transform: rotate(45deg);

}



.faq-a {

  max-height: 0;

  overflow: hidden;

  transition: max-height 0.4s ease;

}



.faq-item.open .faq-a {

  max-height: 200px;

}



.faq-a p {

  color: var(--paper-dim);

  font-size: 14.5px;

  line-height: 1.7;

  padding-bottom: 26px;

  max-width: 600px;

}



/* ── Instagram Strip ───────────────────────────────────────── */

.insta {

  border-top: 1px solid var(--line);

  padding: 90px 0;

}



.insta-head {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 36px;

}



.insta-grid {

  display: grid;

  grid-template-columns: repeat(6, 1fr);

  gap: 10px;

}



.insta-grid a {

  display: block;

  overflow: hidden;

  aspect-ratio: 1;

}



.insta-grid img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  transition: transform 0.5s;

  filter: saturate(0.9);

}



.insta-grid a:hover img {

  transform: scale(1.08);

}



/* ── Events ────────────────────────────────────────────────── */

.events {

  border-top: 1px solid var(--line);

}



.event-row {

  display: grid;

  grid-template-columns: 110px 1fr auto auto;

  gap: 30px;

  align-items: center;

  padding: 26px 0;

  border-bottom: 1px solid var(--line);

}



.event-date {

  font-family: 'JetBrains Mono', monospace;

  color: var(--amber);

  font-size: 13px;

}



.event-row h4 {

  font-family: 'Fraunces', serif;

  font-size: 19px;

  font-weight: 500;

}



.event-row .loc {

  color: var(--paper-faint);

  font-size: 13px;

}



.event-tag {

  font-family: 'JetBrains Mono', monospace;

  font-size: 10px;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  border: 1px solid var(--line);

  padding: 6px 12px;

  color: var(--paper-dim);

  white-space: nowrap;

}



/* Featured event card */

.event-featured {

  display: grid;

  grid-template-columns: 1.1fr 0.9fr;

  gap: 60px;

  align-items: center;

  margin-bottom: 80px;

  border: 1px solid var(--line);

  padding: 48px;

}



.event-featured img {

  width: 100%;

  height: 420px;

  object-fit: cover;

  filter: saturate(0.9);

}



.event-featured h3 {

  font-family: 'Fraunces', serif;

  font-size: 34px;

  margin-bottom: 14px;

}



.event-featured p {

  color: var(--paper-dim);

  font-size: 15px;

  line-height: 1.7;

  margin-bottom: 24px;

}



.event-featured .details {

  display: flex;

  gap: 40px;

  margin-bottom: 32px;

}



.event-featured .details div {

  display: flex;

  flex-direction: column;

}



.event-featured .details strong {

  font-family: 'Fraunces', serif;

  font-size: 20px;

  color: var(--amber);

  display: block;

}



.event-featured .details div > *:not(strong) {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.05em;

}



.event-card-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 28px;

  margin-top: 40px;

}



.event-card {

  background: var(--ink-2);

  border: 1px solid var(--line);

  overflow: hidden;

}



.event-card img {

  width: 100%;

  height: 200px;

  object-fit: cover;

  filter: saturate(0.9);

  transition: transform 0.6s;

}



.event-card:hover img {

  transform: scale(1.05);

}



.event-card-body {

  padding: 22px 24px 26px;

}



.event-card-body h4 {

  font-family: 'Fraunces', serif;

  font-size: 19px;

  font-weight: 500;

  margin-bottom: 6px;

}



.event-card-body .loc {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--paper-faint);

  text-transform: uppercase;

  letter-spacing: 0.04em;

  margin-bottom: 18px;

  display: block;

  margin-top: 4px;

}



.event-card-body .btn {

  font-size: 13px;

  padding: 9px 18px;

}



.past-events {

  margin-top: 80px;

}



.past-events img {

  opacity: 0.6;

}



/* ── Testimonials ──────────────────────────────────────────── */

.testimonials {
  border-top: 1px solid var(--line);
  background: var(--ink);
  padding-bottom: 80px;
}

.t-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.t-card {
  background: linear-gradient(145deg, var(--ink-2) 0%, var(--ink) 100%);
  padding: 42px 32px;
  border: 1px solid var(--line);
  border-radius: 8px;
  position: relative;
  transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.t-card::before {
  content: '“';
  position: absolute;
  top: 24px;
  left: 32px;
  font-family: 'Fraunces', serif;
  font-size: 64px;
  color: var(--amber);
  opacity: 0.15;
  line-height: 1;
}

.t-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  border-color: rgba(224, 164, 74, 0.3);
}

.t-card p {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  font-style: normal;
  line-height: 1.6;
  color: var(--paper);
  margin-bottom: 32px;
  position: relative;
  z-index: 1;
  font-weight: 300;
}

.t-who {
  display: flex;
  align-items: center;
  gap: 16px;
  border-top: 1px solid var(--line);
  padding-top: 24px;
}

.t-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  filter: saturate(1.1);
  border: 2px solid rgba(224, 164, 74, 0.2);
}

.t-who strong {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--amber);
  display: block;
  margin-bottom: 2px;
}

.t-who span {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--paper-faint);
}



/* ── Contact Page ──────────────────────────────────────────── */

.contact-grid {

  display: grid;

  grid-template-columns: 0.7fr 1fr;

  gap: 80px;

  align-items: start;

}



.contact-info-card {

  margin-bottom: 32px;

  padding-bottom: 28px;

  border-bottom: 1px solid var(--line);

}



.contact-info-card h4 {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.08em;

  color: var(--amber);

  margin-bottom: 10px;

}



.contact-info-card a,

.contact-info-card p {

  color: var(--paper-dim);

  font-size: 15px;

  display: block;

  margin-bottom: 4px;

}



.contact-info-card a:hover {

  color: var(--amber);

}



.map-frame {

  position: relative;

  margin-top: 16px;

}



.map-frame img {

  width: 100%;

  height: 200px;

  object-fit: cover;

  filter: saturate(0.6);

}



.contact-form h3,

.contact-form-box h3 {

  font-family: 'Fraunces', serif;

  font-size: 28px;

  font-weight: 400;

  margin-bottom: 8px;

}



.contact-form > p,

.contact-form-box > p {

  color: var(--paper-dim);

  font-size: 14.5px;

  margin-bottom: 28px;

  line-height: 1.6;

}



.contact-form-box {

  background: var(--ink);

  border: 1px solid var(--line);

  padding: 48px 44px;

}



.contact-aside-photo {

  margin-bottom: 32px;

  overflow: hidden;

}



.contact-aside-photo img {

  width: 100%;

  height: 220px;

  object-fit: cover;

  display: block;

  filter: saturate(0.9);

}



.social-link {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.06em;

  color: var(--paper-dim);

  border: 1px solid var(--line);

  padding: 8px 16px;

  margin: 0 8px 8px 0;

  display: inline-block;

}



.social-link:hover {

  border-color: var(--amber);

  color: var(--amber);

}



.reply-note {

  margin-top: 8px;

  padding: 28px;

  border: 1px solid var(--line);

  background: var(--ink-2);

}



.reply-note span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 0.08em;

  color: var(--amber);

  display: block;

  margin-bottom: 14px;

}



.reply-note p {

  font-family: 'Fraunces', serif;

  font-size: 20px;

  color: var(--paper);

  line-height: 1.35;

  margin: 0;

}



.submit-btn {

  width: 100%;

  justify-content: center;

  margin-top: 8px;

}



/* ── Auth (Log in / Get started) ───────────────────────────── */

.auth-page {

  min-height: 100vh;

  padding: 48px 24px;

  display: flex;

  align-items: center;

  justify-content: center;

  position: relative;

  background-color: var(--ink);

  background-position: center;

  background-size: cover;

  background-repeat: no-repeat;

}



.auth-page::before {

  content: '';

  position: absolute;

  inset: 0;

  background: rgba(21, 19, 15, 0.68);

}



.auth-page--login {

  background-image: url('img/auth_camera_bg.webp');

}



.auth-page--start {

  background-image: url('img/auth_camera_bg.webp');

}



.auth-box {

  position: relative;

  z-index: 1;

  width: 100%;

  max-width: 500px;

  background: rgba(21, 19, 15, 0.88);

  backdrop-filter: blur(12px);

  border: 1px solid var(--line);

  padding: 32px 32px;

  text-align: center;

}



.auth-back-btn {

  position: absolute;

  top: 20px;

  left: 20px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  width: 40px;

  height: 40px;

  color: var(--paper-dim);

  text-decoration: none;

  border-radius: 50%;

  background: rgba(243, 236, 224, 0.06);

  border: 1px solid var(--line);

  transition: all 0.25s ease;

  z-index: 10;

}



.auth-back-btn:hover {

  color: var(--amber);

  border-color: var(--amber);

  background: rgba(224, 164, 74, 0.15);

  transform: translateX(-3px);

}



.auth-back-btn svg {

  transition: transform 0.25s ease;

}



.auth-back-btn:hover svg {

  transform: translateX(-2px);

}



.auth-box .logo {

  justify-content: center;

  margin-bottom: 12px;

}



.auth-box .logo img {

  height: 40px;

}



.auth-box .eyebrow {

  justify-content: center;

}



.auth-box h1 {

  font-family: 'Fraunces', serif;

  font-size: clamp(28px, 3.5vw, 36px);

  font-weight: 500;

  letter-spacing: -0.02em;

  margin: 6px 0 4px;

}



.auth-box > p {

  color: var(--paper-dim);

  font-size: 14px;

  line-height: 1.45;

  margin-bottom: 20px;

}



.auth-box form {

  text-align: left;

}



.role-pick {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 10px;

}



.role-pick label {

  display: flex;

  flex-direction: column;

  gap: 2px;

  padding: 10px 12px;

  border: 1px solid var(--line);

  background: var(--ink-2);

  cursor: pointer;

  text-align: center;

  transition: border-color 0.25s;

}



.role-pick label:has(input:checked) {

  border-color: var(--amber);

}



.role-pick input {

  position: absolute;

  opacity: 0;

  pointer-events: none;

}



.role-pick span {

  font-family: 'Fraunces', serif;

  font-size: 15px;

  color: var(--paper);

}



.role-pick em {

  font-style: normal;

  font-family: 'JetBrains Mono', monospace;

  font-size: 9.5px;

  letter-spacing: 0.05em;

  text-transform: uppercase;

  color: var(--paper-faint);

}



.auth-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 16px;

  margin: -4px 0 16px;

  font-size: 13px;

  color: var(--paper-dim);

}



.auth-check {

  display: flex;

  align-items: center;

  gap: 10px;

  cursor: pointer;

}



.auth-check input {

  accent-color: var(--amber);

}



.password-wrap {

  position: relative;

  display: flex;

  align-items: center;

  width: 100%;

}



.password-wrap input {

  padding-right: 42px !important;

}



.toggle-password-btn {

  position: absolute;

  right: 12px;

  background: none;

  border: none;

  color: var(--paper-dim);

  cursor: pointer;

  padding: 4px;

  display: flex;

  align-items: center;

  justify-content: center;

  transition: color 0.2s ease;

}



.toggle-password-btn:hover {

  color: var(--amber);

}



.auth-switch {

  margin-top: 16px;

  padding-top: 14px;

  border-top: 1px solid var(--line);

  font-size: 13.5px;

  color: var(--paper-dim);

}



.auth-switch a {

  color: var(--amber);

}



.auth-switch a:hover {

  color: var(--paper);

}



.form-row {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 14px;

  margin-bottom: 12px;

}



.field {

  display: flex;

  flex-direction: column;

  gap: 5px;

  margin-bottom: 12px;

}



.form-row .field {

  margin-bottom: 0;

}



.field label {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.08em;

  color: var(--paper-faint);

}



.field input,

.field select,

.field textarea {

  background: var(--ink-2);

  border: 1px solid var(--line);

  color: var(--paper);

  font-family: 'Inter', sans-serif;

  font-size: 14px;

  padding: 12px 14px;

  outline: none;

  transition: border-color 0.25s;

  border-radius: 0;

  width: 100%;

}



.field textarea {

  min-height: 120px;

  resize: vertical;

}



.field input:focus,

.field select:focus,

.field textarea:focus {

  border-color: var(--amber);

}

.field input.is-invalid,
.field select.is-invalid,
.field textarea.is-invalid,
.foot-form input.is-invalid {
  border-color: #e53e3e;
}

.field-error {
  font-size: 12px;
  color: #e53e3e;
  margin: 0;
  line-height: 1.4;
}

.foot-form {
  flex-wrap: wrap;
}

.foot-form .field-error {
  flex-basis: 100%;
  order: 3;
  margin-top: 8px;
}



select option {

  background: var(--ink-2);

}



.offices {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 24px;

  margin-top: 0;

}



.office-card {

  border: 1px solid var(--line);

  padding: 0;

  overflow: hidden;

  background: var(--ink);

}



.office-thumb {

  aspect-ratio: 16 / 10;

  overflow: hidden;

  background: var(--ink-2);

}



.office-thumb img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

  filter: saturate(0.9);

}



.office-card .office-body {

  padding: 28px;

}



.office-card h4 {

  font-family: 'Fraunces', serif;

  font-size: 22px;

  font-weight: 400;

  margin-bottom: 10px;

}



.office-card address,

.office-card p {

  font-style: normal;

  color: var(--paper-dim);

  font-size: 14px;

  line-height: 1.7;

  margin-bottom: 12px;

}



.office-card .hours,

.office-card span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  color: var(--amber);

  text-transform: uppercase;

  letter-spacing: 0.05em;

}



/* ── Newsletter Band ───────────────────────────────────────── */

.newsletter-band {

  border-top: 1px solid var(--line);

  text-align: center;

  padding: 120px 0;

}



.newsletter-band .eyebrow {

  justify-content: center;

}



.newsletter-band h2 {

  font-family: 'Fraunces', serif;

  font-size: clamp(28px, 4vw, 52px);

  max-width: 600px;

  margin: 0 auto;

}



.newsletter-band p {

  color: var(--paper-dim);

  margin: 16px auto 32px;

  max-width: 420px;

}



.newsletter-form {

  display: flex;

  gap: 12px;

  justify-content: center;

  margin-top: 28px;

  flex-wrap: wrap;

}



.newsletter-form input {

  background: var(--ink-2);

  border: 1px solid var(--line);

  color: var(--paper);

  font-family: 'Inter', sans-serif;

  font-size: 14px;

  padding: 13px 18px;

  outline: none;

  min-width: 260px;

  transition: border-color 0.25s;

}



.newsletter-form input::placeholder {

  color: var(--paper-faint);

}



.newsletter-form input:focus {

  border-color: var(--amber);

}



.newsletter-form .btn {

  flex-shrink: 0;

}



/* ── CTA Band ──────────────────────────────────────────────── */

.cta-band {

  position: relative;

  border-top: 1px solid var(--line);

  text-align: center;

  padding: 130px 0;

  background: url('img/cta_work.webp') center / cover no-repeat;

}



.cta-band::before {

  content: '';

  position: absolute;

  inset: 0;

  background: rgba(21, 19, 15, 0.78);

}



.cta-band .wrap {

  position: relative;

  z-index: 1;

}



.cta-band .eyebrow {

  justify-content: center;

}



.cta-band h2 {

  font-family: 'Fraunces', serif;

  font-size: clamp(34px, 5vw, 64px);

  max-width: 760px;

  margin: 0 auto;

}



.cta-band p {

  color: var(--paper-dim);

  margin: 22px auto 40px;

  max-width: 420px;

}



.cta-band .hero-cta {

  justify-content: center;

}



.cta-band .hero-cta .btn {

  min-width: 200px;

  text-align: center;

  padding: 14px 32px;

  font-size: 15px;

}



/* ── Footer ────────────────────────────────────────────────── */

footer {

  border-top: 1px solid var(--line);

  padding: 80px 0 30px;

}



.foot-grid {

  display: grid;

  grid-template-columns: 2fr 1fr 1fr 1.5fr;

  gap: 40px;

  padding-bottom: 60px;

}



.foot-brand p {

  color: var(--paper-dim);

  font-size: 14px;

  margin-top: 16px;

  max-width: 280px;

  line-height: 1.6;

}



.foot-col h5 {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  color: var(--paper-faint);

  margin-bottom: 18px;

}



.foot-col p {

  color: var(--paper-dim);

  font-size: 13.5px;

  margin-bottom: 16px;

  line-height: 1.6;

}



.foot-col a:hover {

  color: var(--amber);

}



.foot-form {

  display: flex;

  border-bottom: 1px solid var(--line);

  padding-bottom: 10px;

}



.foot-form input {

  background: none;

  border: none;

  outline: none;

  color: var(--paper);

  font-family: 'Inter', sans-serif;

  font-size: 14px;

  flex: 1;

}



.foot-form input::placeholder {

  color: var(--paper-faint);

}



.foot-form button {

  background: none;

  border: none;

  color: var(--amber);

  font-size: 14px;

  cursor: pointer;

  font-weight: 600;

  font-family: 'Inter', sans-serif;

}



.foot-bottom {

  display: flex;

  justify-content: space-between;

  align-items: center;

  padding-top: 26px;

  border-top: 1px solid var(--line);

  font-size: 12.5px;

  color: var(--paper-faint);

}



.foot-bottom .socials {

  display: flex;

  gap: 22px;

}



.foot-bottom .socials a {

  color: var(--paper-faint);

  transition: color 0.25s;

}



.foot-bottom .socials a:hover {

  color: var(--amber);

}



/* ── Scroll Reveal ─────────────────────────────────────────── */

.reveal {

  opacity: 0;

  transform: translateY(24px);

  transition: opacity 0.8s, transform 0.8s;

}



.reveal.in {

  opacity: 1;

  transform: translateY(0);

}



/* ── Pagination ────────────────────────────────────────────── */

.pagination {

  display: flex;

  gap: 8px;

  justify-content: center;

  margin-top: 60px;

  align-items: center;

}



.pagination a, .pagination span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 13px;

  width: 40px;

  height: 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 1px solid var(--line);

  color: var(--paper-dim);

  transition: border-color 0.25s, color 0.25s;

}



.pagination a:hover,

.pagination .current {

  border-color: var(--amber);

  color: var(--amber);

}



/* ── Responsive ────────────────────────────────────────────── */

/* ── Mobile auth section ── */
.mobile-auth {
  display: none;
}

@media (max-width: 980px) {

  .navlinks {

    display: none;

  }



  .navlinks.open {

    display: flex;

    flex-direction: column;

    position: absolute;

    top: 78px;

    left: 0;

    right: 0;

    background: var(--ink);

    padding: 20px 40px;

    gap: 18px;

    border-bottom: 1px solid var(--line);

    z-index: 99;

  }



  .burger {

    display: flex;

  }

  .navright {
    display: none;
  }

  /* ── Mobile auth section inside hamburger ── */
  .navlinks .mobile-auth {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 18px;
    margin-top: 6px;
    border-top: 1px solid var(--line);
  }

  .navlinks .mobile-auth .mobile-login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: var(--paper-dim);
    padding: 12px 0;
    transition: color 0.25s;
    text-decoration: none;
  }

  .navlinks .mobile-auth .mobile-login:hover {
    color: var(--amber);
  }

  .navlinks .mobile-auth .mobile-login svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
  }

  .navlinks .mobile-auth .mobile-getstarted {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--amber);
    border: 1px solid var(--amber);
    border-radius: var(--radius);
    padding: 14px 24px;
    text-decoration: none;
    transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.25s;
    line-height: 1;
  }

  .navlinks .mobile-auth .mobile-getstarted:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .navlinks .mobile-auth .mobile-getstarted svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.5;
  }



  .hero {

    grid-template-columns: 1fr;

    padding-top: 150px;

  }



  .stack {

    height: 400px;

    margin-top: 40px;

  }



  .about-grid {

    grid-template-columns: 1fr;

  }



  .about-frame img {

    height: 340px;

  }



  .gallery-grid {

    grid-template-columns: repeat(2, 1fr);

  }





  .t-grid {

    grid-template-columns: 1fr;

  }



  .foot-grid {

    grid-template-columns: 1fr 1fr;

  }



  .service-row {

    padding: 48px 0;

  }

  .service-row h3 {

    font-size: 32px;

  }

  .service-row p {

    font-size: 15px;

    padding: 0 12px;

  }

  .service-row .arrow {

    width: 40px;

    height: 40px;

    font-size: 18px;

  }



  .featured-post {

    grid-template-columns: 1fr;

  }



  .featured-post img {

    height: 280px;

  }



  .journal-stats {

    grid-template-columns: 1fr 1fr;

  }



  .journal-grid {

    grid-template-columns: 1fr 1fr;

  }



  .contact-form-box {

    padding: 28px 22px;

  }



  .service-grid,

  .service-grid--4 {

    grid-template-columns: 1fr 1fr;

  }



  .event-tag {

    display: none;

  }



  .pkg-grid {

    grid-template-columns: 1fr;

  }



  .process-grid {

    grid-template-columns: 1fr 1fr;

  }



  .team-grid {

    grid-template-columns: 1fr 1fr;

  }



  .insta-grid {

    grid-template-columns: repeat(3, 1fr);

  }



  .contact-grid {

    grid-template-columns: 1fr;

  }



  .auth-box {

    padding: 36px 22px;

  }



  .event-card-grid {

    grid-template-columns: 1fr 1fr;

  }



  .event-featured {

    grid-template-columns: 1fr;

  }



  .offices {

    grid-template-columns: 1fr;

  }



  .section-head {

    flex-direction: column;

    align-items: flex-start;

    gap: 24px;

    margin-bottom: 48px;

  }



  .form-row {

    grid-template-columns: 1fr;

  }



  .wrap {

    padding: 0 24px;

  }



  .nav {

    padding: 0 24px;

  }

}



@media (max-width: 600px) {

  .foot-grid {

    grid-template-columns: 1fr;

  }



  .hero-meta {

    flex-wrap: wrap;

    gap: 20px;

  }



  .stat-row {

    flex-wrap: wrap;

    gap: 24px;

  }



  .pkg-grid {

    grid-template-columns: 1fr;

  }



  .journal-grid {

    grid-template-columns: 1fr;

  }



  .journal-stats {

    grid-template-columns: 1fr;

  }



  .service-grid,

  .service-grid--4 {

    grid-template-columns: 1fr;

  }

}



/* ── Dashboard ─────────────────────────────────────────────── */

.dash {

  display: grid;

  grid-template-columns: 240px 1fr;

  min-height: 100vh;

  background: var(--ink);

}



.dash-side {

  border-right: 1px solid var(--line);

  padding: 28px 22px;

  display: flex;

  flex-direction: column;

  background: var(--ink-2);

}



.dash-side .logo {

  margin-bottom: 36px;

}



.dash-side .logo img {

  height: 36px;

}



.dash-nav a {

  display: block;

  font-size: 14px;

  color: var(--paper-dim);

  padding: 10px 12px;

  margin-bottom: 4px;

  border-left: 2px solid transparent;

}



.dash-nav a:hover,

.dash-nav a.is-on {

  color: var(--paper);

  border-left-color: var(--amber);

  background: rgba(224, 164, 74, 0.06);

}



.dash-side .out {

  margin-top: auto;

  font-size: 13px;

  color: var(--paper-faint);

}



.dash-side .out:hover {

  color: var(--amber);

}



.dash-main {

  padding: 36px 44px 56px;

}



.dash-top {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 24px;

  margin-bottom: 36px;

}



.dash-top h1 {

  font-family: 'Fraunces', serif;

  font-size: clamp(28px, 3vw, 38px);

  font-weight: 400;

  margin-top: 8px;

}



.dash-stats {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 16px;

  margin-bottom: 40px;

}



.dash-stat {

  border: 1px solid var(--line);

  padding: 22px 20px;

  background: var(--ink-2);

}



.dash-stat strong {

  display: block;

  font-family: 'Fraunces', serif;

  font-size: 28px;

  color: var(--amber);

  font-weight: 500;

  margin-bottom: 6px;

}



.dash-stat span {

  font-family: 'JetBrains Mono', monospace;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.06em;

  color: var(--paper-faint);

}



.dash-block {

  margin-bottom: 44px;

}



.dash-block h2 {

  font-family: 'Fraunces', serif;

  font-size: 24px;

  font-weight: 400;

  margin-bottom: 18px;

}



.dash-shots {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 16px;

}



.dash-shot {

  overflow: hidden;

  border: 1px solid var(--line);

}



.dash-shot img {

  width: 100%;

  aspect-ratio: 4 / 3;

  object-fit: cover;

  display: block;

  filter: saturate(0.92);

}



.dash-shot p {

  padding: 12px 14px;

  font-size: 13px;

  color: var(--paper-dim);

}



.dash-table {

  width: 100%;

  border-collapse: collapse;

  font-size: 14px;

}



.dash-table th {

  font-family: 'JetBrains Mono', monospace;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 0.08em;

  color: var(--paper-faint);

  text-align: left;

  padding: 12px 14px;

  border-bottom: 1px solid var(--line);

}



.dash-table td {

  padding: 14px;

  border-bottom: 1px solid var(--line);

  color: var(--paper-dim);

}



.dash-table td:first-child {

  color: var(--paper);

}



.dash-view[hidden] {

  display: none;

}



@media (max-width: 980px) {

  .dash {

    grid-template-columns: 1fr;

  }



  .dash-side {

    flex-direction: row;

    flex-wrap: wrap;

    align-items: center;

    gap: 16px;

  }



  .dash-side .logo {

    margin-bottom: 0;

  }



  .dash-nav {

    display: flex;

    flex-wrap: wrap;

    gap: 4px;

  }



  .dash-side .out {

    margin-top: 0;

    margin-left: auto;

  }



  .dash-main {

    padding: 28px 20px 48px;

  }



  .dash-stats,

  .dash-shots {

    grid-template-columns: 1fr 1fr;

  }

}

@media (prefers-reduced-motion: reduce) {

  * {

    animation-duration: 0.01ms !important;

    transition-duration: 0.01ms !important;

  }

}


/* ── Mobile overflow prevention ───────────────────────────── */
@media (max-width: 768px) {

  /* Force all major containers to stay within viewport */
  html, body {
    overflow-x: hidden;
    width: 100%;
  }

  section, footer, header, div, main {
    max-width: 100vw;
  }

  /* Stackly Logo Size on Mobile */
  .nav .logo span,
  .logo span,
  header .logo span {
    font-size: 42px !important;
    font-weight: 700 !important;
  }

  .nav .logo img,
  .logo img,
  header .logo img {
    height: 64px !important;
  }

  /* Center Footer Content in Mobile View */
  footer {
    text-align: center;
  }

  .foot-contact-strip {
    grid-template-columns: 1fr !important;
    gap: 1.5rem !important;
    padding-bottom: 2rem !important;
    margin-bottom: 2.5rem !important;
  }

  .foot-contact-strip > div {
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    gap: 0.75rem !important;
    background: rgba(243, 236, 224, 0.03);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1.25rem 1rem;
    width: 100%;
  }

  .foot-contact-strip > div > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .foot-contact-strip h5 {
    margin-bottom: 6px !important;
  }

  .foot-grid {
    grid-template-columns: 1fr !important;
    text-align: center;
    justify-items: center;
  }

  .foot-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .foot-brand p {
    max-width: 100% !important;
    text-align: center;
  }

  .foot-brand > div {
    justify-content: center;
  }

  .foot-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .foot-form {
    justify-content: center;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
  }

  /* Footer bottom row */
  .foot-bottom {
    flex-direction: column;
    gap: 12px;
    text-align: center;
  }

  .foot-bottom .socials {
    justify-content: center;
  }

  /* CTA band buttons */
  .cta-band .hero-cta .btn {
    min-width: 0;
    width: 100%;
  }

  .cta-band .hero-cta {
    flex-direction: column;
    align-items: stretch;
  }

  /* Hero CTA buttons */
  .hero-cta {
    flex-wrap: wrap;
  }

  .hero-cta .btn {
    min-width: 0;
  }

  /* Images & media must not exceed container */
  img, video, iframe, canvas, svg {
    max-width: 100%;
  }

  /* Tables */
  table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }

  /* Prevent pre/code blocks from overflowing */
  pre, code {
    overflow-x: auto;
    max-width: 100%;
    word-break: break-word;
  }
}


/* ── 3-Second Website Loader Screen ───────────────────────── */
#stackly-loader {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: var(--ink);
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: auto;
}

#stackly-loader.loader-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 18px;
}

/* Camera Lens Icon Animation */
.loader-camera-wrap {
  position: relative;
  width: 72px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loader-camera-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid rgba(224, 164, 74, 0.2);
  border-top-color: var(--amber);
  animation: cameraSpin 1.4s linear infinite;
}

.loader-camera-icon {
  width: 36px;
  height: 36px;
  color: var(--amber);
  animation: cameraPulse 1.8s ease-in-out infinite;
}

.loader-brand {
  font-family: 'Fraunces', serif;
  font-size: 38px;
  font-weight: 600;
  letter-spacing: -0.5px;
  color: var(--amber);
  text-shadow: 0 0 24px rgba(224, 164, 74, 0.4);
  margin-top: 4px;
}

.loader-sub {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--paper-dim);
}

/* Loader Progress Bar */
.loader-progress-track {
  width: 160px;
  height: 3px;
  background: rgba(243, 236, 224, 0.1);
  border-radius: 3px;
  overflow: hidden;
  margin-top: 8px;
}

.loader-progress-fill {
  width: 0%;
  height: 100%;
  background: var(--amber);
  border-radius: 3px;
  animation: loaderProgress 3s cubic-bezier(0.1, 0.5, 0.2, 1) forwards;
}

@keyframes cameraSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes cameraPulse {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.1); opacity: 1; }
}

@keyframes loaderProgress {
  0% { width: 0%; }
  40% { width: 45%; }
  75% { width: 80%; }
  100% { width: 100%; }
}
